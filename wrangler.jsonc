{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "countr-status-page-cronjob",
  "main": "./build/index.js",
  "workers_dev": true,
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["no_nodejs_compat", "no_nodejs_compat_v2"], // we do not need Node.js compatibility

  "build": {
    "command": "npm run build"
  },

  "triggers": {
    "crons": ["* * * * *"] // every minute
  },

  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": true
    }
  },

  "placement": {
    "mode": "smart"
  },

  "vars": {
    // Sensitive data should be stored in the worker itself as an encrypted value... in other terms: NOT IN THIS FILE!
    // Method 1 is to use the wrangler command: wrangler secret put <key> where key is the environment variable name
    // Method 2 is to put them in through the workers dashboard
    //
    // Sensitive environment variables:
    // - COUNTR_API_ENDPOINT                - The endpoint for Countr's Manager API
    // - COUNTR_PREMIUM_API_ENDPOINT        - The endpoint for Countr Premium's Manager API (optional)
    // - INSTATUS_API_KEY                   - The Instatus user key
    // - INSTATUS_ALLOW_COMPONENT_CREATION  - Optional, set to true or 1 to allow creating missing Instatus components
    // - INSTATUS_ALLOW_METRIC_CREATION     - Optional, set to true or 1 to allow creating missing Instatus metrics
    "INSTATUS_PAGE_ID": "cl65biobd12760uwok6x5h82w8" // The Instatus page ID
  },

  "vpc_services": [
    { // Countr stats
      "binding": "COUNTR_VPC_SERVICE",
      "service_id": "01a1786d-6f06-7283-a0e9-c46cf2802d22",
      "remote": true
    },
    { // Countr premium stats
      "binding": "COUNTR_PREMIUM_VPC_SERVICE",
      "service_id": "01a1786d-deae-7093-9597-e402927bf8d7",
      "remote": true
    }
  ]
}
